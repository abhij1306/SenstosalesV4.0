{
  "$schema": "https://railway.com/schema.json",
  "build": {
    "builder": "PYTHON",
    "python": {
      "version": "3.11",
      "requirementsPath": "backend/requirements.txt"
    }
  },
  "deploy": {
    "startCommand": "bash start.sh",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30
  }
}
